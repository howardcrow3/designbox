<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- Mac App Store entitlements for DesignBox. package-appstore.sh replaces @TEAM_ID@ and writes the
     result next to the build; the direct-download build keeps using entitlements.plist (no sandbox).
     The App Sandbox is mandatory for the store. Add a capability only with a reason here:
       network.client       live collaboration sessions and update-free web fetches
       user-selected.rw     files the person picks in open/save dialogs or drops onto the window
     Files opened from the command line or by path are NOT reachable under the sandbox. -->
<plist version="1.0">
<dict>
  <key>com.apple.security.app-sandbox</key>
  <true/>
  <key>com.apple.security.network.client</key>
  <true/>
  <key>com.apple.security.files.user-selected.read-write</key>
  <true/>
  <key>com.apple.application-identifier</key>
  <string>@TEAM_ID@.studio.turtlebox.designbox</string>
  <key>com.apple.developer.team-identifier</key>
  <string>@TEAM_ID@</string>
</dict>
</plist>

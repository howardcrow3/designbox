<?xml version="1.0" encoding="utf-8"?>
<!--
  DesignBox MSI (WiX Toolset v5: `dotnet tool install -g wix`, plus the UI and Util extensions:
  `wix extension add -g WixToolset.UI.wixext/5.0.2 WixToolset.Util.wixext/5.0.2`). Built by package.ps1:

    wix build designbox.wxs -arch x64 -ext WixToolset.UI.wixext -ext WixToolset.Util.wixext
      -culture en-US -loc designbox.en-us.wxl -d Version=1.2.3 -d DisplayVersion=1.2.3-rc.1
      -d BinDir=... -d IconPath=... -d BannerBmp=... -d DialogBmp=... -d HasCli=1 -o out.msi

  Per-machine install with a setup wizard that names the version: Welcome, install folder
  (Program Files\DesignBox by default, remembered for upgrades), Ready, a progress page, and a
  Finish page with a ticked "Launch DesignBox" box. Installs a Start Menu shortcut, makes
  DesignBox the owner of `.designbox`, and offers it under "Open with" for SVG, PNG and JPEG
  (without taking over the user's default app for them), plus designbox-cli when HasCli=1.
  `msiexec /qn` still installs silently.

  UpgradeCode is fixed for DesignBox forever (generated once; never reuse another app's).
-->
<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs"
     xmlns:ui="http://wixtoolset.org/schemas/v4/wxs/ui">
  <Package
      Name="DesignBox"
      Manufacturer="Turtle Box"
      Version="$(var.Version)"
      UpgradeCode="7F8B9827-D065-41B7-A514-2A454B21F484"
      Scope="perMachine"
      Compressed="yes"
      Language="1033">
    <SummaryInformation Description="DesignBox interface design and prototyping tool" Manufacturer="Turtle Box" />
    <!-- Same-version upgrades let successive pre-releases of one X.Y.Z replace each other
         (MSI versions are numeric, so 1.2.3-rc.1 and 1.2.3-rc.2 are both 1.2.3). -->
    <MajorUpgrade AllowSameVersionUpgrades="yes"
        DowngradeErrorMessage="A newer version of DesignBox is already installed." />
    <MediaTemplate EmbedCab="yes" CompressionLevel="high" />

    <!-- MSI caches this icon using its Id as the filename. Advertised shortcuts to an
         .exe need an .exe icon identifier (ICE50), even when the source is an ICO. -->
    <Icon Id="DesignboxIcon.exe" SourceFile="$(var.IconPath)" />
    <Property Id="ARPPRODUCTICON" Value="DesignboxIcon.exe" />
    <Property Id="ARPURLINFOABOUT" Value="https://turtlebox.studio/apps/designbox" />
    <Property Id="ARPURLUPDATEINFO" Value="https://turtlebox.studio/apps/designbox" />
    <Property Id="ARPHELPLINK" Value="https://turtlebox.studio" />

    <StandardDirectory Id="ProgramFiles6432Folder">
      <Directory Id="INSTALLFOLDER" Name="DesignBox" />
    </StandardDirectory>
    <StandardDirectory Id="ProgramMenuFolder" />

    <!-- An upgrade installs where the user put the previous version (written by DesignboxApp). -->
    <Property Id="INSTALLFOLDER">
      <RegistrySearch Id="PreviousInstallFolder" Root="HKLM" Key="Software\DesignBox" Name="InstallDir" Type="raw" />
    </Property>

    <Feature Id="Main" Title="DesignBox" Level="1">
      <ComponentGroupRef Id="DesignboxFiles" />
    </Feature>

    <!-- The setup wizard: WixUI_InstallDir without its licence page (the code is MIT OR
         Apache-2.0; there is nothing to accept). A later NewDialog on the same button wins. -->
    <ui:WixUI Id="WixUI_InstallDir" InstallDirectory="INSTALLFOLDER" />
    <UI>
      <Publish Dialog="WelcomeDlg" Control="Next" Event="NewDialog" Value="InstallDirDlg" Order="2" Condition="NOT Installed" />
      <Publish Dialog="InstallDirDlg" Control="Back" Event="NewDialog" Value="WelcomeDlg" Order="2" />
      <Publish Dialog="ExitDialog" Control="Finish" Event="DoAction" Value="LaunchDesignbox"
          Condition="WIXUI_EXITDIALOGOPTIONALCHECKBOX = 1 AND NOT Installed" />
    </UI>
    <!-- Our own art, generated by package.ps1 from the app icon (not WiX's stock bitmaps). -->
    <WixVariable Id="WixUIBannerBmp" Value="$(var.BannerBmp)" />
    <WixVariable Id="WixUIDialogBmp" Value="$(var.DialogBmp)" />

    <!-- The full version (Version is numeric, so it drops a pre-release tag), shown on the wizard's
         pages through designbox.en-us.wxl. -->
    <Property Id="DesignboxVersion" Value="$(var.DisplayVersion)" />

    <!-- Finish page: say where to find the app, and offer to start it (ticked by default). -->
    <Property Id="WIXUI_EXITDIALOGOPTIONALTEXT" Value="DesignBox $(var.DisplayVersion) is installed. You can start it any time from the Start menu." />
    <Property Id="WIXUI_EXITDIALOGOPTIONALCHECKBOXTEXT" Value="Launch DesignBox" />
    <Property Id="WIXUI_EXITDIALOGOPTIONALCHECKBOX" Value="1" />
    <Property Id="WixShellExecTarget" Value="[#DesignboxExe]" />
    <!-- Runs in the wizard's own (unelevated) process, so the app starts as the user, not as admin. -->
    <CustomAction Id="LaunchDesignbox" BinaryRef="Wix4UtilCA_$(sys.BUILDARCHSHORT)" DllEntry="WixShellExec" Impersonate="yes" Return="ignore" />
  </Package>

  <Fragment>
    <ComponentGroup Id="DesignboxFiles" Directory="INSTALLFOLDER">
      <Component Id="DesignboxApp" Guid="238228C3-4C1D-4B33-8C5D-C31B65BC2DA4">
        <File Id="DesignboxExe" Source="$(var.BinDir)\designbox.exe" KeyPath="yes">
          <Shortcut Id="StartMenuShortcut" Directory="ProgramMenuFolder" Name="DesignBox"
              Description="DesignBox interface design and prototyping" WorkingDirectory="INSTALLFOLDER" Advertise="yes"
              Icon="DesignboxIcon.exe" IconIndex="0" />
        </File>

        <!-- .designbox: DesignBox's own format; DesignBox is its default app. -->
        <ProgId Id="Designbox.Document" Description="DesignBox Document" Icon="DesignboxExe" IconIndex="0">
          <Extension Id="designbox" ContentType="application/x-designbox">
            <Verb Id="open" Command="Open" TargetFile="DesignboxExe" Argument="&quot;%1&quot;" />
          </Extension>
        </ProgId>
        <!-- SVG and images: offered under "Open with", never forced as the default. -->
        <ProgId Id="Designbox.Image" Description="Image" Icon="DesignboxExe" IconIndex="0" />
        <RegistryValue Root="HKLM" Key="Software\Classes\Designbox.Image\shell\open\command" Value="&quot;[#DesignboxExe]&quot; &quot;%1&quot;" Type="string" />
        <RegistryValue Root="HKLM" Key="Software\Classes\.svg\OpenWithProgids" Name="Designbox.Image" Value="" Type="string" />
        <RegistryValue Root="HKLM" Key="Software\Classes\.png\OpenWithProgids" Name="Designbox.Image" Value="" Type="string" />
        <RegistryValue Root="HKLM" Key="Software\Classes\.jpg\OpenWithProgids" Name="Designbox.Image" Value="" Type="string" />
        <RegistryValue Root="HKLM" Key="Software\Classes\.jpeg\OpenWithProgids" Name="Designbox.Image" Value="" Type="string" />

        <!-- "Open with" app list and the Run dialog (Win+R "designbox"). -->
        <RegistryValue Root="HKLM" Key="Software\Classes\Applications\designbox.exe" Name="FriendlyAppName" Value="DesignBox" Type="string" />
        <RegistryValue Root="HKLM" Key="Software\Classes\Applications\designbox.exe\shell\open\command" Value="&quot;[#DesignboxExe]&quot; &quot;%1&quot;" Type="string" />
        <RegistryValue Root="HKLM" Key="Software\Classes\Applications\designbox.exe\SupportedTypes" Name=".designbox" Value="" Type="string" />
        <RegistryValue Root="HKLM" Key="Software\Classes\Applications\designbox.exe\SupportedTypes" Name=".svg" Value="" Type="string" />
        <RegistryValue Root="HKLM" Key="Software\Classes\Applications\designbox.exe\SupportedTypes" Name=".png" Value="" Type="string" />
        <RegistryValue Root="HKLM" Key="Software\Classes\Applications\designbox.exe\SupportedTypes" Name=".jpg" Value="" Type="string" />
        <RegistryValue Root="HKLM" Key="Software\Classes\Applications\designbox.exe\SupportedTypes" Name=".jpeg" Value="" Type="string" />
        <RegistryValue Root="HKLM" Key="Software\Microsoft\Windows\CurrentVersion\App Paths\designbox.exe" Value="[#DesignboxExe]" Type="string" />
        <RegistryValue Root="HKLM" Key="Software\DesignBox" Name="InstallDir" Value="[INSTALLFOLDER]" Type="string" />
      </Component>

<?if $(var.HasCli) = 1 ?>
      <Component Id="DesignboxCli">
        <File Id="DesignboxCliExe" Source="$(var.BinDir)\designbox-cli.exe" KeyPath="yes" />
      </Component>
<?endif?>
    </ComponentGroup>
  </Fragment>
</Wix>

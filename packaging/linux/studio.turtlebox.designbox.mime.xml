<?xml version="1.0" encoding="UTF-8"?>
<!-- shared-mime-info definition for DesignBox's own document type (SVG, PNG and JPEG are already in
     the system database). Installed to /usr/share/mime/packages/ (update-mime-database runs on
     install). -->
<mime-info xmlns="http://www.freedesktop.org/standards/shared-mime-info">
  <mime-type type="application/x-designbox">
    <comment>DesignBox document</comment>
    <icon name="studio.turtlebox.designbox"/>
    <glob pattern="*.designbox"/>
  </mime-type>
</mime-info>
